# Gemini (IA que escreve as cartas)
GEMINI_API_KEY=

# Supabase — use a chave SECRETA (sb_secret_...) ou a service_role.
# Nunca coloque essa chave no frontend nem no GitHub.
SUPABASE_URL=https://dioearsjbcxjpfcpvhig.supabase.co
SUPABASE_SECRET_KEY=

# Senha para acessar /api/admin/metrics e /api/letters (header x-admin-token)
ADMIN_TOKEN=

PORT=3000

# Asaas (pagamentos Pix e cartão) — configure SÓ na Vercel
# Chave da API: Asaas > Integrações > Chaves de API ($aact_prod_... ou $aact_hmlg_... no sandbox)
ASAAS_API_KEY=
# Opcional: sandbox ou production (se vazio, detecta pela chave)
ASAAS_ENV=
# Token que você inventa (32+ caracteres) e cadastra no webhook do Asaas
ASAAS_WEBHOOK_TOKEN=
# Opcional: endereço público do site (para o Asaas devolver o cliente)
PUBLIC_SITE_URL=

# E-mail depois da compra (opcional) — resend.com, precisa de domínio verificado
RESEND_API_KEY=
EMAIL_FROM=Carta Mágica <papainoel@seudominio.com.br>
